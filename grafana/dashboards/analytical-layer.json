{
  "id": null,
  "uid": "gdep-batch",
  "title": "Ghana Analytical Layer",
  "description": "Nightly Spark batch output: daily OHLC, cedi trend, cocoa seasonality, weather correlations.",
  "tags": [
    "ghana",
    "batch",
    "spark",
    "delta"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5m",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m",
      "30m",
      "1h"
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Daily bars \u2014 Spark batch",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "candlestick",
      "title": "Cocoa daily OHLC",
      "description": "Recomputed nightly from the Delta lake. Re-running the job is idempotent.",
      "datasource": {
        "type": "postgres",
        "uid": "ghana-dep-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "pointSize": 5
          },
          "unit": "currencyUSD",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "mode": "candles",
        "candleStyle": "candles",
        "colorStrategy": "open-close",
        "colors": {
          "down": "red",
          "up": "green",
          "flat": "gray"
        },
        "includeAllFields": false,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "fields": {
          "open": "open",
          "high": "high",
          "low": "low",
          "close": "close"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ghana-dep-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT trade_date AS time, open_price AS open, high_price AS high,\n       low_price AS low, close_price AS close\nFROM market.daily_ohlc\nWHERE symbol = 'COCOA' AND $__timeFilter(trade_date)\nORDER BY 1",
          "editorMode": "code"
        }
      ]
    },

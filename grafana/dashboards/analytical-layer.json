    {
      "id": 5,
      "type": "timeseries",
      "title": "USD/GHS close with 7d & 30d moving averages",
      "description": "Moving averages need history; with one day in the lake they equal the close.",
      "datasource": {
        "type": "postgres",
        "uid": "ghana-dep-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 14,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "opacity",
            "showPoints": "always",
            "spanNulls": true,
            "pointSize": 7,
            "axisBorderShow": false,
            "scaleDistribution": {
              "type": "linear"
            }
          },
          "unit": "none",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",

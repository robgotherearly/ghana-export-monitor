    {
      "id": 8,
      "type": "barchart",
      "title": "Monthly average cocoa price by crop phase",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "ghana-dep-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 14,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "axisBorderShow": false,
            "fillOpacity": 80,
            "gradientMode": "none",
            "lineWidth": 1,
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "unit": "currencyUSD",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "xTickLabelRotation": -45,
        "xTickLabelSpacing": 0,
        "showValue": "auto",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.85,
        "fullHighlight": false,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ghana-dep-pg"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_char(month_start, 'YYYY-MM') AS \"month\",\n       round(avg_price::numeric, 2)    AS \"avg price\",\n       crop_phase                      AS \"phase\"\nFROM market.cocoa_seasonal\nORDER BY month_start",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Season summary",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "ghana-dep-pg"
      },
      "gridPos": {
        "x": 14,
        "y": 20,
        "w": 10,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ghana-dep-pg"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT season                        AS \"season\",\n       crop_phase                    AS \"phase\",\n       to_char(month_start,'YYYY-MM') AS \"month\",\n       round(avg_price::numeric, 2)  AS \"avg\",\n       round(min_price::numeric, 2)  AS \"low\",\n       round(max_price::numeric, 2)  AS \"high\",\n       observations                  AS \"obs\"\nFROM market.cocoa_seasonal\nORDER BY month_start DESC\nLIMIT 24",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Weather / price correlation & pipeline health",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "table",
      "title": "Cocoa price vs. regional weather (hourly buckets)",
      "description": "n is written alongside so a correlation built on thin history is visibly thin.",
      "datasource": {
        "type": "postgres",
        "uid": "ghana-dep-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 14,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "correlation"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "semi-dark-blue",
                      "value": null
                    },
                    {
                      "color": "text",
                      "value": -0.2
                    },
                    {
                      "color": "semi-dark-orange",
                      "value": 0.2
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ghana-dep-pg"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT region_id    AS \"region\",\n       metric       AS \"weather metric\",\n       round(correlation::numeric, 3) AS \"correlation\",\n       observations AS \"n\",\n       computed_at  AS \"computed\"\nFROM market.weather_price_correlation\nWHERE symbol = 'COCOA'\nORDER BY abs(coalesce(correlation, 0)) DESC\nLIMIT 40",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 12,
      "type": "table",
      "title": "Batch runs",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "ghana-dep-pg"
      },
      "gridPos": {
        "x": 14,
        "y": 30,
        "w": 10,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "succeeded": {
                        "color": "green",
                        "index": 0
                      },
                      "failed": {
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ghana-dep-pg"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT job_name    AS \"job\",\n       started_at  AS \"started\",\n       status      AS \"status\",\n       rows_written AS \"rows\",\n       detail      AS \"detail\"\nFROM market.pipeline_runs\nORDER BY started_at DESC\nLIMIT 20",
          "editorMode": "code"
        }
      ]
    }
  ]
}

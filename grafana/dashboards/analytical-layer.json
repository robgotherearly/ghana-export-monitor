          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ghana-dep-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT trade_date AS time,\n       close_rate AS \"close\",\n       ma_7       AS \"7-day MA\",\n       ma_30      AS \"30-day MA\"\nFROM market.cedi_depreciation\nWHERE pair = 'USD/GHS' AND $__timeFilter(trade_date)\nORDER BY 1",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Cedi depreciation over 1d / 7d / 30d",
      "description": "Positive = the cedi lost ground over that horizon. Each series stays empty until the lake holds that many days of closes.",
      "datasource": {
        "type": "postgres",
        "uid": "ghana-dep-pg"
      },
      "gridPos": {
        "x": 14,
        "y": 11,
        "w": 10,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 60,
            "gradientMode": "opacity",
            "showPoints": "always",
            "spanNulls": true,
            "pointSize": 7,
            "axisBorderShow": false,
            "scaleDistribution": {
              "type": "linear"
            }
          },
          "unit": "percent",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ghana-dep-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT trade_date AS time,\n       change_1d_pct  AS \"1 day\",\n       change_7d_pct  AS \"7 day\",\n       change_30d_pct AS \"30 day\"\nFROM market.cedi_depreciation\nWHERE pair = 'USD/GHS' AND $__timeFilter(trade_date)\nORDER BY 1",
          "editorMode": "code"
        }
      ]
    },
    {

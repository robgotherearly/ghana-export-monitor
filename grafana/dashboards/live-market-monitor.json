      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ghana-dep-pg"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "-- The newest sliding window has only just opened and usually holds a single\n-- tick, so its stddev is 0. Read the newest *closed* window that actually has\n-- enough ticks to have a spread.\nSELECT DISTINCT ON (symbol) symbol, volatility_pct\nFROM market.commodity_metrics\nWHERE window_start > now() - interval '30 minutes'\n  AND window_end <= now()\n  AND tick_count >= 3\nORDER BY symbol, window_start DESC",
          "editorMode": "code"
        }
      ]
    },

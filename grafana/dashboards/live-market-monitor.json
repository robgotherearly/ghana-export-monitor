          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ghana-dep-pg"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"ticks\"\nFROM (\n  SELECT ts_event FROM market.commodity_ticks WHERE ts_event > now() - interval '1 hour'\n  UNION ALL\n  SELECT ts_event FROM market.fx_ticks WHERE ts_event > now() - interval '1 hour'\n  UNION ALL\n  SELECT ts_event FROM market.weather_readings WHERE ts_event > now() - interval '1 hour'\n) t",
          "editorMode": "code"
        }

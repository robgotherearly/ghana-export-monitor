# ---------------------------------------------------------------------------
# Copy to .env and edit. Every value here has a working default - the stack
# runs end to end on genuinely live data with NO API keys at all.
# ---------------------------------------------------------------------------

# -- Ports (change if something already owns one) ---------------------------
KAFKA_EXTERNAL_PORT=9092
POSTGRES_PORT=5432
GRAFANA_PORT=3000
SPARK_UI_PORT=4040
KAFKA_UI_PORT=8080

# -- Postgres ---------------------------------------------------------------
POSTGRES_DB=ghana_dep
POSTGRES_USER=ghana
POSTGRES_PASSWORD=ghana

# -- Grafana ----------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# -- Poll cadence (seconds) -------------------------------------------------
COMMODITY_POLL_SECONDS=60
FX_POLL_SECONDS=30
WEATHER_POLL_SECONDS=120

# -- Provider chains (first configured + not rate-limited provider wins) ----
COMMODITY_PROVIDERS=yahoo,twelvedata,api_ninjas,commodities_api,simulated
FX_PROVIDERS=open_er_api,exchangerate_host,twelvedata,frankfurter,simulated
WEATHER_PROVIDERS=open_meteo,openweathermap,simulated

# Last-resort random walk from the last real print when every live source is
# down. Always tagged source=simulated / is_simulated=true in the payload.
# Set to false to let the pipeline go quiet instead.
ALLOW_SIMULATED_FALLBACK=true

# -- Optional API keys (all blank = key-free sources only) ------------------
TWELVEDATA_API_KEY=
COMMODITIES_API_KEY=
API_NINJAS_API_KEY=
EXCHANGERATE_HOST_API_KEY=
OPENWEATHERMAP_API_KEY=

# -- Spark ------------------------------------------------------------------
SPARK_MASTER_URL=local[*]
# The JVM heap is not the whole story: PySpark forks a Python worker per
# sink partition alongside it. Leave headroom for those.
SPARK_DRIVER_MEMORY=1024m
SPARK_BATCH_MEMORY=1g
SPARK_SHUFFLE_PARTITIONS=4
SINK_PARTITIONS=1
SPARK_LOG_LEVEL=WARN
# base micro-batch cadence; each of the six queries gets its own offset
TRIGGER_SECONDS=20
STARTING_OFFSETS=latest

# -- Windowing & anomaly thresholds ----------------------------------------
PRICE_WINDOW=5 minutes
PRICE_SLIDE=1 minute
WATERMARK_DELAY=2 minutes
ZSCORE_THRESHOLD=2.5
PRICE_JUMP_PCT=1.5
CEDI_DEPRECIATION_PCT=0.5

# -- Optional alert delivery (docker compose --profile tools up -d) ---------
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
